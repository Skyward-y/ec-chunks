{
  "name": "ec-chunks",
  "version": "0.6.0",
  "description": "语境词块本 · 把整篇文章拆成词块来背的离线英语学习 App",
  "main": "electron/main.js",
  "author": "Skyward-y",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:dir && node tools/build-installer.js && node tools/build-portable.js",
    "dist:dir": "node tools/stamp-sw.js && electron-builder --win dir",
    "stamp": "node tools/stamp-sw.js",
    "dist:inno": "node tools/build-installer.js",
    "dist:portable": "node tools/build-portable.js",
    "pack:app": "node tools/update-app.js",
    "test": "node tools/smoke.js",
    "lint": "eslint electron tools sw.js app.js pwa.js redirect.js",
    "lint:html": "node tools/lint-html.js",
    "lint:all": "npm run lint && npm run lint:html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint:all && npm test"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10"
  },
  "build": {
    "appId": "io.github.skywardy.ecchunks",
    "productName": "EcChunks",
    "electronVersion": "45.0.0",
    "electronDist": "node_modules/electron/dist",
    "copyright": "Copyright © 2026 Skyward-y",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "*.html",
      "*.js",
      "manifest.webmanifest",
      "sw.js",
      "icon.svg",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "tools/after-pack.js",
    "win": {
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "allowScripts": {
    "electron": true
  }
}
