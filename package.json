{
  "name": "ec-chunks",
  "version": "0.5.0",
  "description": "语境词块本 · 把整篇文章拆成词块来背的离线英语学习 App",
  "main": "electron/main.js",
  "author": "Skyward-y",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "npm run dist:dir && node tools/build-installer.js",
    "dist:dir": "electron-builder --win dir",
    "dist:inno": "node tools/build-installer.js",
    "pack:app": "node tools/update-app.js"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.skywardy.ecchunks",
    "productName": "EcChunks",
    "electronVersion": "45.0.0",
    "electronDist": "node_modules/electron/dist",
    "copyright": "Copyright © 2026 Skyward-y",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "*.html",
      "manifest.webmanifest",
      "sw.js",
      "icon.svg",
      "package.json"
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "afterPack": "tools/after-pack.js",
    "win": {
      "icon": "electron/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "语境词块本",
      "deleteAppDataOnUninstall": false,
      "artifactName": "EcChunks-${version}-setup.${ext}",
      "script": "installer.nsi",
      "installerLanguages": [
        "zh_CN"
      ],
      "uninstallDisplayName": "语境词块本 ${version}"
    }
  },
  "allowScripts": {
    "electron": true
  }
}
